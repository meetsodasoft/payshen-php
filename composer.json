{
    "name": "payshen/payshen-php",
    "description": "PHP client for the Payshen payment orchestration API: payments, captures, voids, refunds, events and webhook verification.",
    "type": "library",
    "license": "MIT",
    "keywords": ["payshen", "payments", "payment orchestration", "psp", "webhooks", "api"],
    "homepage": "https://www.payshen.com/developers",
    "authors": [
        {
            "name": "Sodasoft LLC",
            "homepage": "https://www.payshen.com"
        }
    ],
    "support": {
        "docs": "https://www.payshen.com/developers",
        "issues": "https://www.payshen.com/help"
    },
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Payshen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Payshen\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
